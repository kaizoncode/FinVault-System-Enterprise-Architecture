# ==============================================================================
# FinVault Enterprise - Environment Configuration Template (.env.example)
# Enterprise Personal & Family Wealth Management System
# ==============================================================================

# Khóa bí mật mã hóa dữ liệu tài chính cấp độ thuộc tính JPA (256-bit Hex = 64 ký tự)
# Lệnh sinh khóa ngẫu nhiên trên Linux/macOS: openssl rand -hex 32
# Lệnh sinh khóa ngẫu nhiên trên PowerShell (Windows):
# -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
FINVAULT_AES_KEY=4f8b2c1e7a9d0f3b5e8a1c4d7f0b2e5a8d1c4f7b0e3a6c9d2f5b8e1a4d7c0f3e

# Cookie Security (Bắt buộc đặt true khi chạy môi trường HTTPS Production)
COOKIE_SECURE=false

# Cổng khởi chạy máy chủ (Mặc định: 8080)
SERVER_PORT=8080

# Profile hoạt động (development / production)
SPRING_PROFILES_ACTIVE=development
